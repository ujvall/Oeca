// Windows resources for Oeca.exe: application icon and version information.
// Compiled by build.rs with the Windows SDK resource compiler (rc.exe) and
// linked into the executable. Version values come from Cargo.toml through
// version.h, which build.rs generates.

#include "version.h"

// The lowest icon ID is the one Explorer and the taskbar show for the exe
1 ICON "assets/branding/Oeca.ico"

1 VERSIONINFO
FILEVERSION     OECA_VERSION_BINARY
PRODUCTVERSION  OECA_VERSION_BINARY
FILEFLAGSMASK   0x3FL
FILEFLAGS       0x0L
FILEOS          0x40004L // VOS_NT_WINDOWS32
FILETYPE        0x1L     // VFT_APP
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0" // U.S. English, Unicode
        BEGIN
            VALUE "CompanyName",      "Ujval Sai"
            VALUE "FileDescription",  "Oeca"
            VALUE "FileVersion",      OECA_VERSION_STRING
            VALUE "InternalName",     "Oeca"
            VALUE "LegalCopyright",   "Copyright (c) 2026 Ujval Sai"
            VALUE "OriginalFilename", "Oeca.exe"
            VALUE "ProductName",      "Oeca"
            VALUE "ProductVersion",   OECA_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
